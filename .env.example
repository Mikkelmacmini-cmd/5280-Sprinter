# ---------------------------------------------------------------------------
# 5280 Sprinter hiring backend — environment variables
# Copy to ".env" for local dev (netlify dev), and set the same keys in the
# Netlify dashboard (Site settings -> Environment variables) for production.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com -> API Keys). Used to send the emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address Resend sends as. Must be on a domain you've verified in
# Resend. Before you verify your own domain you can use: onboarding@resend.dev
RESEND_FROM_EMAIL=hiring@yourdomain.com

# Fallback destination for applications, used only until you set one in /admin.
DEFAULT_TO_EMAIL=owner@yourdomain.com

# Admin login. Email is optional (leave blank to accept any email + password).
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Secret used to sign admin session cookies. Use a long random string, e.g.
# run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
